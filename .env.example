# Modelo dos arquivos .env.development, .env.homolog e .env.production (não versionados).
# Os scripts npm escolhem o arquivo: npm run android / android:homolog / android:prod.
# Variáveis EXPO_PUBLIC_* vão para o bundle do app: NUNCA coloque segredos aqui.
EXPO_PUBLIC_API_URL=https://api.example.com
# true = auth, OCR e API simulados (mock)
EXPO_PUBLIC_USE_MOCKS=true
