{
  "name": "ocr-stara",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "^5.104.3",
    "drizzle-orm": "^0.45.4",
    "expo": "~57.0.30",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "i18next": "^26.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.18",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "^57.0.16",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "cross-env APP_ENV=development dotenv -e .env.development -- expo start",
    "start:homolog": "cross-env APP_ENV=homolog dotenv -e .env.homolog -- expo start",
    "start:prod": "cross-env APP_ENV=production dotenv -e .env.production -- expo start",
    "android": "cross-env APP_ENV=development dotenv -e .env.development -- expo run:android",
    "ios": "cross-env APP_ENV=development dotenv -e .env.development -- expo run:ios",
    "android:homolog": "cross-env APP_ENV=homolog dotenv -e .env.homolog -- expo run:android",
    "ios:homolog": "cross-env APP_ENV=homolog dotenv -e .env.homolog -- expo run:ios --device",
    "android:prod": "cross-env APP_ENV=production dotenv -e .env.production -- expo run:android",
    "ios:prod": "cross-env APP_ENV=production dotenv -e .env.production -- expo run:ios --device",
    "prebuild:dev": "cross-env APP_ENV=development dotenv -e .env.development -- expo prebuild --clean",
    "prebuild:homolog": "cross-env APP_ENV=homolog dotenv -e .env.homolog -- expo prebuild --clean",
    "prebuild:prod": "cross-env APP_ENV=production dotenv -e .env.production -- expo prebuild --clean",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:generate": "drizzle-kit generate",
    "doctor": "npx expo-doctor",
    "validate": "npm run typecheck && npm test -- --runInBand && npm run lint"
  },
  "private": true
}
